# Same Google Web OAuth client used by the mobile API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server-side only; do not prefix with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:4000
# Set to the browser-facing origin when behind a reverse proxy.
WEB_ORIGIN=http://localhost:3000
# Server-only shared secret, matching the API. Never use a NEXT_PUBLIC_ prefix.
WEB_PROXY_SECRET=

# Public legal pages are served at /privacy, /terms, /health-connect and /delete-account.
# Operator details are set on the server at build time for these static pages.
LEGAL_OPERATOR_NAME=FitSync
SUPPORT_EMAIL=sahillsahudev@gmail.com
# Set the mobile download link from the admin dashboard.
# Optional social destinations (HTTPS). Empty values stay hidden.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
