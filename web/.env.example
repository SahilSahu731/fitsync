# Same Google Web OAuth client used by the mobile API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server-side only; do not prefix with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:4000
# Set to the browser-facing origin when behind a reverse proxy.
WEB_ORIGIN=http://localhost:3000

# Optional published footer destinations (HTTPS). Empty values stay hidden.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
