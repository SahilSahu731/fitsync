PORT=4000
NODE_ENV=development
# Shared with the Next.js server only; required for per-client web auth limits.
WEB_PROXY_SECRET=
# PostHog API timings. Leave the project token empty to disable exporting.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_TRACE_SAMPLE_RATE=0.01
# Render staging sets this to staging. Other deployments default to NODE_ENV.
# POSTHOG_ENVIRONMENT=development
# Optional error reporting. Only fixed failure categories and code locations are sent.
SENTRY_DSN=
SENTRY_RELEASE=
# Enable Expo push security on your project, then set this server-only token on API and cron.
EXPO_ACCESS_TOKEN=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
GOOGLE_WEB_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# Generate once per environment using openssl rand -hex 32.
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# Optional billing. Keep secrets on the server; blank disables purchases/Pro APIs.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=fitsync_pro
# Exact Authorization header configured in RevenueCat; use at least 32 random characters.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Only enable for an isolated test backend using sandbox purchases.
REVENUECAT_ALLOW_SANDBOX=false
