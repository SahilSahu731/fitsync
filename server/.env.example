PORT=4000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
GOOGLE_WEB_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=replace_with_a_long_random_secret_at_least_48_characters
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# Optional billing. Keep secrets on the server; blank disables purchases/Pro APIs.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=pro
# Exact Authorization header configured in RevenueCat; use at least 32 random characters.
REVENUECAT_WEBHOOK_AUTHORIZATION=
# Only enable for an isolated test backend using sandbox purchases.
REVENUECAT_ALLOW_SANDBOX=false
