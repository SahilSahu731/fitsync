{
  "cli": {
    "version": ">= 24.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "store-test": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview"
    }
  },
  "submit": {
    "production": {}
  }
}
