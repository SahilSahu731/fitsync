EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# RevenueCat public SDK keys only. Never put a secret API key in the app.
# Store purchases require a native development or production build.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Published HTTPS legal pages are required before subscriptions can be sold.
# Optional overrides; otherwise /terms and /privacy on EXPO_PUBLIC_WEB_URL are used.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
# HTTPS origin of your deployed FitSync website, used for revocable coach links.
EXPO_PUBLIC_WEB_URL=

# Public ingestion keys (not management API tokens). See docs/observability-setup.md.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
# Build-only configuration. The upload token must NEVER have an EXPO_PUBLIC_ prefix.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Enable only for development/preview telemetry smoke tests. Forbidden in production.
EXPO_PUBLIC_TELEMETRY_DEBUG=false
