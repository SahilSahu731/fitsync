{
  "expo": {
    "name": "FitSync",
    "slug": "fitsync",
    "scheme": "fitsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.sahil.fitsync",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#101011",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#C5F460",
          "defaultChannel": "workout-rest-v2",
          "sounds": [
            "./assets/sound/rest_complete.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101011",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.androidonly"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitSync to select a profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow FitSync to count steps during walks you choose to record."
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FitSync reads steps, sleep and weight to fill your progress journal when you choose to import.",
          "NSHealthUpdateUsageDescription": "FitSync does not write to Apple Health.",
          "background": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow FitSync to add training sessions you choose to your calendar.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9829030-6ee5-45ac-8cbb-55fe6602c5dc"
      }
    },
    "owner": "sahillsahudevs-team",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
