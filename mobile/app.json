{
  "expo": {
    "name": "FitSync",
    "slug": "fitsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitsync-icon.png",
    "scheme": "fitsync",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/fitsync-icon.png",
      "bundleIdentifier": "com.sahilsahu.fitsync"
    },
    "android": {
      "package": "com.sahilsahu.fitsync",
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/images/fitsync-mark.png",
        "monochromeImage": "./assets/images/fitsync-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/fitsync-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090B",
          "image": "./assets/images/fitsync-splash.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
