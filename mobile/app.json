{
  "expo": {
    "name": "FitSync",
    "slug": "fitsync",
    "scheme": "fitsync",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "platforms": ["android"],
    "android": {
      "package": "com.sahil.fitsync",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#101011",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.sahil.fitsync"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C5F460",
          "defaultChannel": "general-v1",
          "sounds": ["./assets/sound/rest_complete.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101011",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitSync to select a profile photo or a private progress photo you choose.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow FitSync to count steps during walks you choose to record."
        }
      ],
      "react-native-health-connect",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow FitSync to add training sessions you choose to your calendar.",
          "remindersPermission": false,
          "writeOnlyAccess": true,
          "writeOnlyCalendarPermission": "Allow FitSync to add training sessions you choose to your calendar."
        }
      ],
      "./plugins/with-purchases"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9829030-6ee5-45ac-8cbb-55fe6602c5dc"
      }
    },
    "owner": "sahillsahudevs-team",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d9829030-6ee5-45ac-8cbb-55fe6602c5dc"
    }
  }
}
