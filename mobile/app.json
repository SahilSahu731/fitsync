{
  "expo": {
    "name": "FitSync",
    "slug": "fitsync",
    "scheme": "fitsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "platforms": ["android"],
    "android": {
      "package": "com.sahil.fitsync",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#101011"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101011",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.androidonly"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitSync to select a profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9829030-6ee5-45ac-8cbb-55fe6602c5dc"
      }
    },
    "owner": "sahillsahudevs-team"
  }
}
